#
#  Windows-container equivalent of Dockerfile-build: builds the shared library as a
#  Windows DLL and generates java bindings with the windows-x64 jextract build.
#
#  Requires a Windows Docker daemon (Windows Server / Docker Desktop in "Windows
#  containers" mode / a windows-latest GitHub Actions runner). This will NOT build
#  on a Linux or macOS Docker host.
#
#  Host OS build must match (or exceed, with matching isolation) the base image tag
#  below. Swap ltsc2022 for ltsc2025 if your host is newer.
#
#  Build arguments:
#    LLVM_MINGW_ARCH - llvm-mingw *host* package to install (x86_64 or aarch64).
#                      Use x86_64 in Windows x86 containers even when LIBRARY_SUFFIX
#                      is -arm64; the cross-compiler is aarch64-w64-mingw32-clang.
#    LIBRARY_SUFFIX  - Output DLL name suffix (empty for amd64, -arm64 for arm64)
#    JEXTRACT_ARCH   - jextract download suffix (x64, aarch64)
#

####################################################################################################
#
# Build container for shared library (Windows DLL)
#
FROM mcr.microsoft.com/windows/servercore:ltsc2022 AS build-shared
SHELL ["powershell", "-NoLogo", "-NonInteractive", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]
WORKDIR C:\\build

ARG CMAKE_VERSION=4.2.3
ARG LLVM_MINGW_VERSION=20260908
ARG NINJA_VERSION=1.13.1
ARG LLVM_MINGW_ARCH=x86_64
ARG LIBRARY_SUFFIX=
ENV CMAKE_VERSION=$CMAKE_VERSION
ENV LLVM_MINGW_VERSION=$LLVM_MINGW_VERSION
ENV NINJA_VERSION=$NINJA_VERSION
ENV LLVM_MINGW_ARCH=$LLVM_MINGW_ARCH
ENV LIBRARY_SUFFIX=$LIBRARY_SUFFIX

# Self-contained toolchain: llvm-mingw bundles clang/lld/mingw-w64 headers+libs, so no
# separate Visual Studio Build Tools / Windows SDK install is required. On x86_64 Windows
# the calling convention is the same for MSVC- and MinGW-built DLLs, so this is ABI-safe
# for the plain C entry points jextract binds against. Ninja is added because llvm-mingw
# does not bundle a make.
COPY ./scripts/docker-install-windows-toolchain.ps1 C:/build/
RUN ["powershell", "-NoLogo", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "C:\\build\\docker-install-windows-toolchain.ps1"]

ADD ./asn1_codec/asn1c_combined/generated-files/2024.tar.gz C:/build/
COPY ./CMakeLists.txt C:/build/
COPY ./src            C:/build/src/
COPY ./scripts/docker-build-windows-dll.ps1      C:/build/

# Windows-specific asn1c workaround, per generated-files/README.md /
# prepare-for-windows.sh: NTFS is case-insensitive, so the project's own
# generated-files/2024/Time.h collides with <time.h> when GeneralizedTime.c
# does #include <time.h>, silently shadowing the real system header (struct
# tm never gets fully defined, localtime/gmtime/mktime/setenv all end up
# undeclared). The project's documented fix is to drop GeneralizedTime and
# its dependents entirely rather than reference the real time.h.
RUN $filesToRemove = @( \
        'GeneralizedTime.h', 'GeneralizedTime.c', 'GeneralizedTime_ber.c', \
        'GeneralizedTime_print.c', 'GeneralizedTime_rfill.c', 'GeneralizedTime_xer.c', \
        'Period.c', 'Period.h', \
        'AggregatedSingleTariffClassSession.c', 'AggregatedSingleTariffClassSession.h', \
        'DetectedChargeObject.c', 'DetectedChargeObject.h', \
        'converter-example.c' \
    ) ; \
    $filesToRemove | ForEach-Object { Remove-Item -Force "C:\build\generated-files\2024\$_" } ; \
    $pduPath = 'C:\build\generated-files\2024\pdu_collection.c' ; \
    (Get-Content $pduPath) -replace 'extern struct asn_TYPE_descriptor_s asn_DEF_Period;', '// extern struct asn_TYPE_descriptor_s asn_DEF_Period;' \
        -replace 'extern struct asn_TYPE_descriptor_s asn_DEF_AggregatedSingleTariffClassSession;', '// extern struct asn_TYPE_descriptor_s asn_DEF_AggregatedSingleTariffClassSession;' \
        -replace 'extern struct asn_TYPE_descriptor_s asn_DEF_DetectedChargeObject;', '// extern struct asn_TYPE_descriptor_s asn_DEF_DetectedChargeObject;' \
        -replace '&asn_DEF_Period,', '// &asn_DEF_Period,' \
        -replace '&asn_DEF_AggregatedSingleTariffClassSession,', '// &asn_DEF_AggregatedSingleTariffClassSession,' \
        -replace '&asn_DEF_DetectedChargeObject,', '// &asn_DEF_DetectedChargeObject,' \
        | Set-Content $pduPath

# Build the DLL in a script file so Docker RUN does not mangle PowerShell $variables.
RUN ["powershell", "-NoLogo", "-NonInteractive", "-ExecutionPolicy", "Bypass", "-File", "C:\\build\\docker-build-windows-dll.ps1"]

## Entrypoint for debugging
#ENTRYPOINT ["powershell", "-Command", "while ($true) { Start-Sleep -Seconds 3600 }"]


####################################################################################################
#
# Build container for jextract
#
FROM eclipse-temurin:25-jdk-windowsservercore-ltsc2022 AS jextract
SHELL ["powershell", "-NoLogo", "-NonInteractive", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]
WORKDIR C:\\build

ARG JEXTRACT_VERSION=25
ARG JEXTRACT_EA=2
ARG JEXTRACT_BUILD=2-4
ARG JEXTRACT_ARCH=x64
ARG GENERATE_JEXTRACT=true

ADD ./j2735-2024-ffm-lib                              C:/build/lib
COPY --from=build-shared C:/build/generated-files/2024 C:/build/generated-files/2024/
COPY --from=build-shared C:/build/src                  C:/build/src/
ADD ./scripts/run-jextract.ps1                          C:/build/
COPY --from=build-shared C:/build/out                  C:/build/out/

ENV JEXTRACT="C:\\jextract\\jextract-25\\bin\\jextract.bat"

RUN if ($env:GENERATE_JEXTRACT -ne 'true') { \
        New-Item -ItemType Directory -Force C:\\build\\java-src | Out-Null ; \
    } else { \
        Invoke-WebRequest -Uri "https://download.java.net/java/early_access/jextract/$($env:JEXTRACT_VERSION)/$($env:JEXTRACT_EA)/openjdk-$($env:JEXTRACT_VERSION)-jextract+$($env:JEXTRACT_BUILD)_windows-$($env:JEXTRACT_ARCH)_bin.tar.gz" -OutFile jextract.tar.gz ; \
        New-Item -ItemType Directory -Force C:\\jextract | Out-Null ; \
        tar -xzf jextract.tar.gz -C C:\\jextract ; \
        Remove-Item jextract.tar.gz ; \
        & $env:JEXTRACT --include-dir C:\\build\\headers \
            --output C:\\build\\java-src \
            --target-package generated \
            --library asnapplication \
            C:\\build\\src\\convert.h ; \
    }

## Entrypoint for debugging
#ENTRYPOINT ["powershell", "-Command", "while ($true) { Start-Sleep -Seconds 3600 }"]
CMD ["powershell", "-File", "C:\\build\\run-jextract.ps1"]
